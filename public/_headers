# Letters are read on their case-study page, not as standalone search results.
/letters/*
  X-Robots-Tag: noindex

# Hashed or versioned assets never change.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep their names when replaced, so cache them for a day only.
/img/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/logos/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/flags/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
